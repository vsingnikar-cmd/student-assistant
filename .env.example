# ==============================================================================
# AI Student Assistant - Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file with secrets to source control.
# ==============================================================================

# Google Gemini API
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-public-key-here"

# (Optional) Supabase Service Role Key
# Required only for trusted server-side username resolution if Edge Function is not deployed
# Keep strictly confidential and never expose to client-side code
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Application Settings
APP_ENV="development"
MAX_UPLOAD_SIZE_MB="15"
MAX_CHAT_CONTEXT_MESSAGES="10"
DEFAULT_QUIZ_QUESTION_COUNT="5"
